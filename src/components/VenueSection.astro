---
import { EVENT_CONFIG } from '../config/event';
import { CountdownTimer } from './CountdownTimer';
const baseUrl = EVENT_CONFIG.baseUrl;
---

<section>
  <div class="flex flex-col md:flex-row md:items-center md:justify-center md:gap-12 md:px-12 lg:px-24 md:py-16">
    <!-- Text content -->
    <div
      data-animate
      class="text-center flex-1 md:max-w-xl px-6 py-16 md:p-0"
    >
      <p class="text-[#4a4c35] text-3xl font-script">
        sábado 16 de mayo de 2026
      </p>

      <div class="mt-8">
        <CountdownTimer client:load />
      </div>

      <img
        src={`${baseUrl}/images/venue-asset.png`}
        alt=""
        loading="lazy"
        class="mx-auto h-32 w-auto"
      />

      <h2 class="font-serif text-2xl uppercase tracking-widest md:tracking-[0.2em] text-text-dark">
        Hacienda la Huerta
      </h2>

      <p class="text-[#4a4c35] mt-4 text-md uppercase ">Ameca, Jalisco</p>
      <!-- <p class="text-md">12:00 PM</p> -->

      <a
        href="https://share.google/PqOAJpFfDqh1sCroW"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 bg-[#cf868b] text-white hover:bg-[#cf868b]/80 w-full max-w-64 mx-auto text-xl inline-block px-8 py-3 font-serif transition-colors duration-300 text-center rounded-full"
      >
        Ver Mapa
      </a>
    </div>

    <!-- Venue photo -->
    <div
      data-animate
      data-delay="200"
      class="flex-1 md:max-w-lg"
    >
      <img
        src={`${baseUrl}/images/venue.jpg`}
        alt="Hacienda Santa Sofía"
        loading="lazy"
        class="w-full h-auto md:shadow-lg"
      />
    </div>
  </div>
</section>
