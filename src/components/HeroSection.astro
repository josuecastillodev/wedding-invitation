---
---

<section class="relative min-h-screen w-full overflow-hidden">
  <!-- Video desktop -->
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover hidden md:block"
  >
    <source src={`${import.meta.env.BASE_URL}/video/hero-desktop.webm`} type="video/webm" />
    <source src={`${import.meta.env.BASE_URL}/video/hero-desktop.mp4`} type="video/mp4" />
  </video>

  <!-- Video mobile -->
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover md:hidden"
  >
    <source src={`${import.meta.env.BASE_URL}/video/hero-mobile.webm`} type="video/webm" />
    <source src={`${import.meta.env.BASE_URL}/video/hero-mobile.mp4`} type="video/mp4" />
  </video>

</section>
