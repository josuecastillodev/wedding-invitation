---
import { EVENT_CONFIG } from "../config/event";
import { translations, type Lang } from "../i18n/translations";
import RichText from "./RichText.astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].gift;
const baseUrl = EVENT_CONFIG.baseUrl;
const { bank } = EVENT_CONFIG;
---

<section id="regalos" class="px-6 text-center scroll-mt-8 pt-8 pb-10">
  <div class="max-w-xl mx-auto">
    <img
      data-animate
      src={`${baseUrl}/images/flowers-separator.png`}
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="mx-auto h-48 w-auto"
    />

    <h2 data-animate class="font-serif text-4xl text-accent -mt-2">
      {t.heading}
    </h2>

    <p
      data-animate
      data-delay="100"
      class="font-serif text-xl md:text-2xl leading-snug text-ink mt-10 mx-auto max-w-[22rem]"
    >
      <RichText segments={t.segments} />
    </p>

    <!-- Tarjeta con borde superior partido para la flor -->
    <div data-animate data-delay="200" class="relative mt-24 mx-auto max-w-sm">
      <img
        src={`${baseUrl}/images/flor-morada.png`}
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="absolute left-1/2 -translate-x-1/2 -top-[3.5rem] h-20 w-auto z-10"
      />

      <div class="relative border border-t-0 border-accent px-6 pt-14 pb-8">
        <div class="absolute top-0 left-0 w-[calc(50%-48px)] h-px bg-accent">
        </div>
        <div class="absolute top-0 right-0 w-[calc(50%-48px)] h-px bg-accent">
        </div>

        <p class="font-serif text-2xl text-ink leading-tight">
          {bank.beneficiary}
        </p>
        <p class="font-script text-ink text-3xl leading-none mt-1">
          {t.nameLabel}
        </p>

        <p
          class="font-serif text-white bg-accent rounded-md text-2xl md:text-3xl tracking-wide py-2 mt-7 mx-auto w-[85%]"
        >
          {bank.account}
        </p>
        <p class="font-script text-ink text-3xl leading-none mt-4">
          {t.accountLabel}
        </p>

        <p
          class="font-serif text-white bg-accent rounded-md text-2xl md:text-3xl tracking-wide py-2 mt-7 mx-auto w-[92%]"
        >
          {bank.clabe}
        </p>
        <p class="font-script text-ink text-3xl leading-none mt-4">
          {t.clabeLabel}
        </p>
      </div>
    </div>
  </div>
</section>
