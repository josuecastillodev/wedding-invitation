---
import { EVENT_CONFIG } from "../config/event";
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].footer;
const baseUrl = EVENT_CONFIG.baseUrl;
---

<footer data-animate class="relative mt-16">
  <!-- Main Section - Burgundy Background -->
  <div class="bg-accent text-white text-center relative">
    <div class="relative text-center px-6 pt-2">
      <!-- Greeting -->
      <p
        data-animate
        data-delay="100"
        class="font-script text-3xl md:text-4xl mt-8"
      >
        {t.greeting}
      </p>

      <!-- Name -->
      <h3
        data-animate
        data-delay="200"
        class="font-serif text-sm md:text-base uppercase tracking-[0.2em] mt-4"
      >
        {t.introName}
      </h3>

      <!-- Description -->
      <div
        data-animate
        data-delay="300"
        class="max-w-2xl mx-auto mt-6 space-y-4 text-xs md:text-sm leading-relaxed text-center md:text-left"
      >
        <p>{t.paragraph1}</p>
        <p>{t.paragraph2}</p>
      </div>
    </div>

    <!-- Logo -->
    <div
      data-animate
      data-delay="400"
      class="w-20 h-20 md:w-24 md:h-24 mx-auto my-6"
    >
      <img
        src={`${baseUrl}/images/logotipo.png`}
        alt="Conceptos Finos"
        loading="lazy"
        class="w-full h-full object-contain"
      />
    </div>

    <!-- Contact Info -->
    <p
      data-animate
      data-delay="500"
      class="font-serif text-sm md:text-base uppercase tracking-[0.15em]"
    >
      {t.contactName}
    </p>
    <a
      href="mailto:gerencia@conceptosfinos.com.mx"
      data-animate
      data-delay="500"
      class="block text-sm md:text-base mt-2 hover:underline"
    >
      gerencia@conceptosfinos.com.mx
    </a>
    <a
      href="tel:+523332233868"
      data-animate
      data-delay="500"
      class="block text-sm md:text-base mt-1 hover:underline"
    >
      33 3223 3868
    </a>

    <!-- Instagram -->
    <div
      data-animate
      data-delay="500"
      class="flex items-center justify-center gap-2 mt-6"
    >
      <span class="text-sm">{t.instagram}</span>
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:opacity-80 hover:scale-110 transition-all duration-300"
        aria-label="Instagram"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="w-5 h-5"
        >
          <rect x="2" y="2" width="20" height="20" rx="5"></rect>
          <circle cx="12" cy="12" r="5"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
          ></circle>
        </svg>
      </a>
    </div>

    <!-- Credits -->
    <p
      data-animate
      data-delay="500"
      class="text-xs md:text-sm mt-1 opacity-80 pb-4"
    >
      {t.credits}
    </p>
  </div>
</footer>
