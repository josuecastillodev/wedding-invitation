---
import { EVENT_CONFIG } from "../config/event";
import { translations, type Lang } from "../i18n/translations";
import { formatEventDate } from "../i18n/date";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].hero;
const baseUrl = EVENT_CONFIG.baseUrl;
const displayDate = formatEventDate(EVENT_CONFIG.eventDate, lang);
---

<section
  id="home"
  class="relative min-h-screen flex flex-col items-center px-6 pt-20 pb-0 overflow-hidden scroll-mt-8"
>
  <!-- Imagen de fondo -->
  <img
    src={`${baseUrl}/images/hero.png`}
    alt=""
    aria-hidden="true"
    class="pointer-events-none select-none absolute inset-0 z-0 h-full w-full object-cover object-center"
  />

  <!-- Degradado oscuro para que el texto blanco se lea -->
  <div
    class="absolute inset-0 z-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"
  >
  </div>

  <!-- Flores decorativas en la esquina inferior (se recortan con el borde del hero) -->
  <img
    src={`${baseUrl}/images/flowers-separator.png`}
    alt=""
    aria-hidden="true"
    class="pointer-events-none select-none absolute z-[5] h-auto max-w-none -translate-x-1/2 [--flores-w:min(116vw,640px)] w-[--flores-w] left-[87%] bottom-[calc(var(--flores-w)*-0.69)]"
  />

  <!-- Contenido principal -->
  <div class="relative z-10 text-center flex-1 flex flex-col justify-center">
    <p data-animate class="font-script text-white text-4xl md:text-5xl mb-4">
      {t.eyebrow}
    </p>

    <h1 class="font-serif text-white inline-block text-right mx-auto my-8">
      <span
        data-animate
        data-delay="100"
        class="block text-5xl md:text-7xl uppercase"
      >
        {EVENT_CONFIG.brideName}
      </span>
      <span
        data-animate
        data-delay="200"
        class="block text-5xl md:text-7xl uppercase"
      >
        <span
          class="font-script normal-case tracking-normal text-6xl md:text-8xl align-baseline"
          >&amp;</span
        >{EVENT_CONFIG.groomName}
      </span>
    </h1>
  </div>

  <!-- Fecha de la boda -->
  <div data-animate data-delay="400" class="relative z-10 mb-16 text-center">
    <p class="font-script text-white text-4xl md:text-5xl">
      {displayDate}
    </p>
  </div>
</section>
