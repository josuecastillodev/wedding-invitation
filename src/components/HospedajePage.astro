---
// Página independiente de Hospedaje: arma Layout + la sección Hospedaje +
// Footer, parametrizado por idioma. Análogo a InvitationPage.astro, usado
// por src/pages/hospedaje.astro (es) y src/pages/en/hospedaje.astro (en).
// La vuelta a la invitación principal se hace desde el menú de hamburguesa
// (link "Home"), no con un botón dedicado en esta página.
import Layout from "../layouts/Layout.astro";
import Hospedaje from "./Hospedaje.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n/translations";
import RsvpCta from "./RsvpCta.astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
---

<Layout lang={lang}>
  <main>
    <Hospedaje lang={lang} />
    <RsvpCta lang={lang} showSilhouette />
    <Footer lang={lang} />
  </main>
</Layout>
