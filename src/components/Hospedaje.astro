---
import { EVENT_CONFIG } from "../config/event";
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].hospedaje;
const baseUrl = EVENT_CONFIG.baseUrl;
const { hotels } = EVENT_CONFIG;

/** Divide `text` en fragmentos normales y resaltados según `highlights`. */
function splitHighlights(text: string, highlights: string[]) {
  const parts: { text: string; highlight: boolean }[] = [];
  let rest = text;
  for (const h of highlights) {
    const i = rest.indexOf(h);
    if (i === -1) continue;
    if (i > 0) parts.push({ text: rest.slice(0, i), highlight: false });
    parts.push({ text: h, highlight: true });
    rest = rest.slice(i + h.length);
  }
  if (rest) parts.push({ text: rest, highlight: false });
  return parts;
}
---

<section id="hospedaje" class="px-6 py-16 text-center scroll-mt-8">
  <h2
    data-animate
    class="font-serif text-2xl md:text-3xl uppercase tracking-[0.15em] text-ink"
  >
    {t.heading}
  </h2>

  {
    hotels.map((hotel) => {
      const copy = t.hotels[hotel.id];
      const parts = splitHighlights(copy.description, copy.highlights);

      return (
        <div class="mt-16 first:mt-10">
          <p data-animate class="font-serif text-2xl md:text-3xl text-ink">
            {hotel.name}
          </p>
          <p
            data-animate
            data-delay="100"
            class="font-script text-accent text-3xl md:text-4xl -mt-3 pl-24"
          >
            {hotel.subtitle}
          </p>

          <div
            data-animate
            data-delay="200"
            class="mt-8 mx-auto max-w-sm shadow-md overflow-hidden"
          >
            <img
              src={`${baseUrl}${hotel.image}`}
              alt={hotel.name}
              loading="lazy"
              class="w-full h-auto object-cover"
            />
          </div>

          <p
            data-animate
            data-delay="300"
            class="font-serif text-xl md:text-2xl leading-relaxed max-w-sm mx-auto mt-8 text-ink"
          >
            {parts.map((part) =>
              part.highlight ? (
                <span class="text-accent italic font-bold">{part.text}</span>
              ) : (
                part.text
              )
            )}
          </p>

          <a
            href={hotel.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-animate
            data-delay="400"
            class="inline-block mt-12 w-48 py-3 font-serif text-2xl uppercase tracking-wide rounded-md bg-accent text-white hover:bg-accent-soft transition-colors duration-300"
          >
            {t.bookNow}
          </a>
        </div>
      );
    })
  }
</section>
