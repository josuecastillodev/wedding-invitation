---
// Botón flotante de WhatsApp, montado una sola vez en Layout.astro para
// aparecer en todo el sitio (invitación principal y Hospedaje). Es un
// simple <a>, sin interactividad — no necesita ser isla de React.
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].whatsapp;
const phoneNumber = "523310631395";
const whatsappHref = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(t.message)}`;
---

<a
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t.ariaLabel}
  class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-[60] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-lg hover:scale-105 transition-transform duration-200"
>
  <svg
    viewBox="0 0 24 24"
    fill="white"
    class="w-7 h-7"
    aria-hidden="true"
  >
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.07c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.8-4.18-4.94-4.37-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.15.12.32.02.51-.1.19-.15.31-.3.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.37 1.47.29.15.46.13.63-.08.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.68.79 1.97.94.29.14.48.21.55.33.07.12.07.68-.17 1.36Z"
    ></path>
  </svg>
</a>
